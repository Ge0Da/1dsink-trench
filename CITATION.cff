    given-names: "David"
    affiliation: "Institute of Deep-sea Science and Engineering, Chinese Academy of Sciences"
keywords:
  - "hadal trench"
  - "morphometrics"
  - "Kuril-Kamchatka Trench"
  - "bathymetry"
  - "sediment trapping"
  - "Trapping Index"
  - "MATLAB"
